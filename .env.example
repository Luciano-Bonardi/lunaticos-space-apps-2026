# =============================================================================
# Lunáticos 2026 — Variables de Entorno (.env.example)
# Copiá este archivo a `.env` y completá los valores locales (no subas `.env`).
# =============================================================================

# --- MCPs conectados en Antigravity ---
# Token de GitHub (usado por los MCPs `github`, `github-mcp-server` y GitHub CLI `gh`)
GITHUB_PERSONAL_ACCESS_TOKEN=
GH_TOKEN=

# Token de API de Hostinger (usado por el MCP `hostinger`)
HOSTINGER_API_TOKEN=

# Credenciales / proyecto de Stitch (si aplica configuración manual)
STITCH_PROJECT_ID=

# --- APIs y Fuentes de Datos del Challenge (NASA) ---
# JPL Horizons API URL base (100% pública, NO requiere API key)
JPL_HORIZONS_API_URL=https://ssd.jpl.nasa.gov/api/horizons.api

# NASA Open APIs (https://api.nasa.gov/) - DEMO_KEY funciona directo; podés sacar una gratis para más límite
NASA_API_KEY=DEMO_KEY
NASA_OPEN_API_URL=https://api.nasa.gov

# NASA Moon Trek WMTS tiles (https://trek.nasa.gov/tiles/apidoc/trekAPI.html?body=moon)
NASA_MOON_TREK_WMTS_URL=https://trek.nasa.gov/tiles/Moon/EQ/LRO_WAC_Mosaic_Global_303ppd_v02/1.0.0/default/default028mm

# Endpoints o rutas locales de topografía LOLA / Moon Trek / Quickmap (A definir por el equipo)
LOLA_DATA_PATH=./data/raw

# --- Configuración de Backend / Frontend (A definir por el equipo) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

